# Copy to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (database name at the end of the path).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/draftera?retryWrites=true&w=majority

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase Storage (private bucket named "drawing-revisions").
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Allowed browser origins, comma separated (no trailing slash).
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app

# Public address of the web app, used for links inside emails (optional;
# defaults to the first non-localhost CLIENT_URL).
APP_URL=

# Session cookie. In production the API (Render) and the web app (Vercel) are
# on different domains, so the default there is SameSite=None; Secure.
# Set COOKIE_SAMESITE=lax only if both are served from the same site.
COOKIE_SAMESITE=

# Email notifications through Brevo's HTTPS API (free plan: 300 emails/day).
# Leave both empty to switch email off; the app works exactly the same.
BREVO_API_KEY=
MAIL_FROM=Draftera <you@example.com>

# Backups: set a long passphrase to encrypt backup files (recommended).
# Keep a copy somewhere safe: without it an encrypted backup cannot be read.
BACKUP_PASSPHRASE=

# AI drawing assistant (Google Gemini). Leave GEMINI_API_KEY empty to switch it off.
# Drawing PDFs are sent to Google when someone asks a question; see docs/security.md.
GEMINI_API_KEY=
# Google retires models on a schedule. If the server log shows 404 "model not available", change this.
GEMINI_MODEL=gemini-3.1-flash-lite
